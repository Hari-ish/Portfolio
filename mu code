.timeline-wrapper{
    position:relative;
    max-width:1000px;
    margin:3rem auto;
    padding:0 2rem;
    font-family: "Inter", sans-serif;
  font-optical-sizing: auto;
  font-weight:700;
  font-style: normal;
}

.timeline-item{
    display:grid;
    grid-template-columns: 1fr 40px 1fr;
    align-items:center;
    column-gap:2rem;
    position:relative;
    margin-bottom:4rem;
        transition:.3s;
}
.timeline-item:hover::before{
    background:#39ff6a;
    box-shadow:0 0 12px #39ff6a;
}
.timeline-item:hover .timeline-card{
    background:#4b3d8d;
    transform:translateY(-5px);
    transition:.3s;
    box-shadow:0 0 20px rgba(57,255,106,.3);
}
.timeline-item:hover .timeline-date{
    color:#39ff6a;
    transition:.3s;
} 
.timeline-item::before{
    content:"";
    position:absolute;
    top:-4rem;
    bottom:-4rem;
    left:50%;
    width:2px;
    background-color:#ffffff;
    transform:translateX(-50%);
    z-index:0;
}

.timeline-wrapper .timeline-item:first-child::before{
    top:50%;
}

.timeline-wrapper .timeline-item:last-child::before{
    bottom:50%;
}

.timeline-dot{
    grid-column:2;
    justify-self:center;
    width:16px;
    height:16px;
    background-color:#39ff6a;
    border:3px solid #ffffff;
    border-radius:50%;
    box-shadow:0 0 8px rgba(57,255,106,0.8);
    z-index:1;
}

.timeline-date{
    color:#ffffff;
    font-size:1.5rem;
    font-weight:700;
    font-family:"Inter", sans-serif;
    white-space:nowrap;
    z-index:1;
}

.timeline-item .timeline-date:first-child{
    text-align:right;
    grid-column:1;
}
.timeline-item .timeline-date:last-child{
    text-align:left;
    grid-column:3;
}

.timeline-card{
    background-color:#3a3170;
    border-radius:10px;
    padding:1.5rem 2.5rem;
    z-index:1;
}

.timeline-item .timeline-card:first-child{
    grid-column:1;
    justify-self:end;
}
.timeline-item .timeline-card:last-child{
    grid-column:3;
    justify-self:start;
}

.timeline-card h3{
    color:#ffffff;
    font-family:"Inter", sans-serif;
    font-size:1.3rem;
    font-weight:700;
    margin:0 0 1rem 0;
}

.timeline-card h3:last-child{
    margin-bottom:0;
}
