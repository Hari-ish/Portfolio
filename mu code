    z-index: 1;
  }
 
  .glow {
    position: absolute;
    width: 260px;
    height: 260px;
    object-fit: contain;
    pointer-events: none;
    z-index: 0;
    animation: driftRL 6s alternate infinite;
  }
 
  .card1:nth-child(1) .glow {
    top: 110px;
    left: -100px;
    z-index: -1;
  }
 
  .card1:nth-child(2) .glow {
    top: -20px;
    left: 20px;
  }
 .card1:nth-child(3) .glow {
    top:80px;
    left: 20px;
  }
.card1:nth-child(4) .glow {
    top:1rem;
    right:-1rem;
  }
  @keyframes driftRL {
    0%   { transform: translateX(60px); }
    50%  { transform: translateX(-60px); }
    100% { transform: translateX(60px); }
  }
 
  .content {
    position: relative;
